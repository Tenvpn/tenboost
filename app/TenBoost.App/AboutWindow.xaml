<!-- Для обычного человека — просто TenBoost. Движок и лицензии компонентов — за неприметной ссылкой внизу:
     тексты лицензий обязаны ехать с программой (папка licenses), но на виду их держать не нужно. -->
<Window x:Class="TenBoost.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе TenBoost" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/TenBoost.ico"
        Background="{StaticResource Ink}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Body}" FontSize="13" TextOptions.TextFormattingMode="Ideal">
  <StackPanel Margin="28,24">
    <TextBlock FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="24">
      <Run Text="Ten" /><Run Text="Boost" Foreground="{StaticResource Accent}" />
    </TextBlock>
    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" Text="Ускоритель YouTube и Discord" />
    <TextBlock x:Name="VersionText" Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource Muted}" />
    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
               Text="Работает на вашем компьютере: без аккаунта, без серверов-посредников, ничего не собирает." />

    <DockPanel Margin="0,24,0,0">
      <Button DockPanel.Dock="Right" Width="110" Style="{StaticResource OutlineButton}" Height="40"
              IsCancel="True" IsDefault="True" Click="OnClose" Content="Закрыть" />
      <Button Style="{StaticResource LinkButton}" FontSize="11.5"
              VerticalAlignment="Center" HorizontalAlignment="Left" Click="OnLicenses"
              Content="Сторонние компоненты и лицензии" />
    </DockPanel>
  </StackPanel>
</Window>
