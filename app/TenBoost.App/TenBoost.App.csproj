<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TenBoost.App</RootNamespace>
    <AssemblyName>TenBoost</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TenBoost.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Шрифты брендбука (OFL), кадры Фера и значок вшиты в сборку: окно не зависит от файлов рядом. -->
    <Resource Include="Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../core/TenBoost.Core/TenBoost.Core.csproj" />
  </ItemGroup>
</Project>
